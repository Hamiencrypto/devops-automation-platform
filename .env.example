# Copy this to .env before `make up` / `docker compose up`:
#   cp .env.example .env
#
# Only the variables docker-compose.yml actually interpolates from the host
# environment belong here (${VAR:-default} in docker-compose.yml). Values
# that are fixed in docker-compose.yml itself — DATABASE_URL, ENABLE_AUTH,
# CORS_ORIGINS, the frontend's NEXT_PUBLIC_* URLs — aren't repeated here;
# edit docker-compose.yml directly if you need to change those.
#
# The defaults below match docker-compose.yml's own fallbacks, so the stack
# runs regex-only with no LLM calls and no API key required out of the box.

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
# JWT signing key. The compose default ("change-me-in-prod") is fine for a
# local demo; set a real random value before exposing this past localhost.
SECRET_KEY=change-me-in-prod

# ---------------------------------------------------------------------
# Hybrid LLM intent layer — off by default (regex-only, zero cost)
# ---------------------------------------------------------------------
ENABLE_LLM=false

# ollama | anthropic | openai
LLM_PROVIDER=ollama

# Only used when LLM_PROVIDER=ollama. Ollama runs on the host, not in the
# compose network, so the backend container reaches it via Docker's host
# gateway alias — leave this as-is unless Ollama is running elsewhere.
OLLAMA_HOST=http://host.docker.internal:11434

# Model name. For LLM_PROVIDER=anthropic, use claude-haiku-4-5 (not the
# deprecated claude-3-haiku-20240307). For ollama, a locally pulled model
# name, e.g. qwen2.5:3b.
LLM_MODEL=claude-haiku-4-5

# Required when LLM_PROVIDER is anthropic or openai; ignored for ollama.
LLM_API_KEY=

# Regex confidence below this threshold falls through to the LLM.
LLM_THRESHOLD=0.65
